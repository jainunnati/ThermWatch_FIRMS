# Copy to .env (never commit .env)

# Google Maps JavaScript API key (V7 map). Restrict it by HTTP referrer in Google Cloud.
# Without a key the map shows an explicit "key missing" state; Alerts, Activity,
# Facilities and Investigation still work on the real data.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Real data is read from static files in /public/data (no backend, no API key):
#   thermwatch_historical.json  validated historical contract (2026-01-01..2026-10-01)
#   thermwatch_live.json        live artifact (or explicit LIVE_FEED_UNAVAILABLE)
#   thermwatch_context.json     facility registry + per-source registry/PIHS enrichment
# Live artifact (optional): the GitHub Actions workflow uses the repository secret FIRMS_MAP_KEY. Never commit a key.
