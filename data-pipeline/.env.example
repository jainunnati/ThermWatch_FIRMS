# Copy this file to .env in this folder (data-pipeline/.env) and fill in your
# own free NASA FIRMS key. Get one here: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# Optional overrides - defaults live in config.py.
# REGION_NAME=South Gujarat Industrial Belt
# REGION_BBOX=68.5,20.5,73.5,23.5
# HISTORICAL_YEARS=3
# RECENT_DAYS=10
# FIRMS_SOURCE_RECENT=VIIRS_SNPP_NRT
# FIRMS_SOURCE_HISTORICAL=VIIRS_SNPP_SP
# INDUSTRIAL_PROXIMITY_KM=3.0
# BASELINE_WINDOW_DAYS=60
